 /**
+ * Submission log. Every form POST is written to the database before SendPulse is
+ * called and then updated with the API result, so a lead survives a SendPulse failure
+ * and losses can be counted.
+ *
+ * status: received (SendPulse not yet answered), created, created_partial (contact made,
+ * phone or messenger call failed), failed, honeypot, too_fast.
+ *
+ * The table has no wp_ prefix and carries the database name, so migrate-dev-to-live.sh
+ * ('wp db clean' plus an import of dev's dump) neither drops nor overwrites live's rows.
+ * Logging must never break a submission: every error here is swallowed.
+ */
+function kd_lead_log($status, $id = 0, $contact_id = null, $error = null) {
+    global $wpdb;
+    try {
+        $table = 'leadlog_' . preg_replace('/\W/', '_', DB_NAME);
+        $show  = $wpdb->suppress_errors(true);
+
+        if ($id) {
+            $wpdb->update($table, [
+                'status'        => $status,
+                'sp_contact_id' => $contact_id,
+                'sp_error'      => $error ? mb_substr($error, 0, 2000) : null,
+            ], ['id' => $id]);
+            $wpdb->suppress_errors($show);
+            return $id;
+        }
+
+        $wpdb->query("CREATE TABLE IF NOT EXISTS `$table` (
+            id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
+            created_at DATETIME NOT NULL,
+            status VARCHAR(20) NOT NULL,
+            sp_contact_id VARCHAR(40) NULL,
+            sp_error TEXT NULL,
+            ip VARCHAR(45) NULL,
+            country VARCHAR(2) NULL,
+            user_agent VARCHAR(255) NULL,
+            payload LONGTEXT NOT NULL,
+            KEY created_at (created_at),
+            KEY status (status)
+        ) DEFAULT CHARSET=utf8mb4");
+
+        $payload = wp_unslash($_POST);
+        unset($payload['action']);
+        $wpdb->insert($table, [
+            'created_at' => gmdate('Y-m-d H:i:s'),
+            'status'     => $status,
+            'ip'         => substr($_SERVER['REMOTE_ADDR'] ?? '', 0, 45),
+            'country'    => substr($_SERVER['HTTP_CF_IPCOUNTRY'] ?? '', 0, 2),
+            'user_agent' => mb_substr($_SERVER['HTTP_USER_AGENT'] ?? '', 0, 255),
+            'payload'    => wp_json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR),
+        ]);
+        $id = (int) $wpdb->insert_id;
+        $wpdb->suppress_errors($show);
+        return $id;
+    } catch (\Throwable $e) {
+        error_log('Lead log error: ' . $e->getMessage());
+        return 0;
+    }
+}
